# Copy to .env and fill in real values locally. NEVER commit a file with real
# values — only this file (names, no secrets) is tracked in git.

# --- Database ------------------------------------------------------------
# Postgres connection string, e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=

# --- App -------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated list of extra origins allowed to call the API cross-origin
# (e.g. a separately-hosted frontend, or another admin tool). Same-origin
# browser requests (the normal case — api-server serves the built frontend
# itself) never need this. Leave empty unless you actually have one.
CORS_ALLOWED_ORIGINS=

# --- Auth ----------------------------------------------------------------------
# Accounts are local (login + password, stored in Postgres) — no external auth
# service, works without internet. The first administrator is created in the
# browser on first launch. Behind an HTTPS reverse proxy set TRUST_PROXY=1 so
# session cookies are marked Secure and rate limits see the real client IP.
TRUST_PROXY=

# Folder for files the server keeps itself (check-in photos). Back it up with the DB.
# In Docker it is the app-data volume.
DATA_DIR=

# --- Telegram bot (stock/write-off notifications) ---------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Object storage (item photos, GCS) ---------------------------------------
# Path (inside the container) to a GCP service-account JSON key with access to
# the bucket(s) below. The @google-cloud/storage client reads this automatically
# — standard GCP auth, no Replit sidecar involved. Mount the real key file as a
# Docker volume/secret; never commit it.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs-service-account.json
# Bucket-relative paths, e.g. "my-bucket/public" / "my-bucket/private". These
# names are historical (from when this ran on Replit's Object Storage), but the
# format is plain GCS: "<bucket>/<prefix>".
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=
